rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isModerator() {
      return isAuthenticated() &&
        (request.auth.token.role == 'MODERATOR' || request.auth.token.role == 'ADMIN');
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: public profile readable, owner can update bio/commute only (cannot self-escalate role or verification)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'STUDENT'
                    && request.resource.data.verificationStatus == 'PENDING';
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verificationStatus', 'karma'])
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Identity mappings: STRICT PRIVACY - ONLY internal trusted backend service can read
    match /identityMappings/{privateId} {
      allow read, write: if false;
    }

    // Communities: readable by authenticated users, created/edited only by verified users/moderators
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.name.size() >= 3;
      allow update: if isModerator() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isAdmin();
    }

    // Posts: public read, authenticated create, author edit/delete
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.title.size() >= 3
                    && request.resource.data.title.size() <= 300
                    && (!request.resource.data.isAnonymous || request.resource.data.authorName == 'Anonymous Student');
      allow update: if isAuthenticated()
                    && (resource.data.authorId == request.auth.uid || isModerator()
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'commentCount', 'acceptedCommentId']));
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());

      // Threaded Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.content.size() >= 1;
        allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isModerator());
      }
    }

    // Commute Hub reports
    match /commuteReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.transportName.size() >= 2;
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    // Bharuch Local Guide listings
    match /localListings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // Safety and Moderation Reports: anyone can create, only admin/mod can read and resolve
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isModerator();
    }
  }
}
